NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Domínio público do site (Open Graph, robots.txt, sitemap.xml). Sem isso cai
# no *.vercel.app de preview (VERCEL_URL) ou em localhost.
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO.com

# Necessária apenas para rodar scripts/import-questoes.ts (ignora RLS).
# Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Caminho da planilha de produção lida pelo script de importação.
PLANILHA_QUESTOES=./Template_Producao_Questoes_ENAMED_ENARE.xlsx

# Segredo compartilhado com a Lowify para autenticar o webhook em
# src/app/api/webhooks/lowify/route.ts (header `x-lowify-token`). Gerar uma
# string aleatória longa e cadastrar a mesma no painel da Lowify.
LOWIFY_WEBHOOK_SECRET=

# DSN do projeto Sentry (Settings > Client Keys). Deixe vazio em desenvolvimento.
NEXT_PUBLIC_SENTRY_DSN=
# Token de autenticação do Sentry, só para o build subir source maps (Settings
# > Auth Tokens, escopo project:releases). Não precisa em desenvolvimento.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
